# ── SokoFlow Environment Variables (Docker Network Setup) ──────────────
# Full Docker stack — all services run inside Docker container network.

APP_NAME=SokoFlow
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
CORRELATION_ID_HEADER=X-Correlation-ID

POSTGRES_USER=sokoflow
POSTGRES_PASSWORD=sokoflow_dev
POSTGRES_DB=sokoflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sokoflow:sokoflow_dev@postgres:5432/sokoflow

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

SESSION_TTL_SECONDS=1800
DEDUP_TTL_SECONDS=60
MAX_FSM_ERRORS=3
SENDER_BACKEND=mock
MESSAGE_SENDER_URL=http://simulator:3000
WEBHOOK_URL=http://api:8000/webhook/whatsapp
product_match_threshold=0.55
confident_match_threshold=0.75

WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret-for-hmac
WHATSAPP_PHONE_NUMBER_ID=+254700000999
WHATSAPP_ACCESS_TOKEN=your-access-token

CELERY_TASK_MAX_RETRIES=5
CELERY_TASK_RETRY_BACKOFF=2
CELERY_TASK_RETRY_BACKOFF_MAX=60
REPORT_TMP_DIR=/tmp/sokoflow_reports
LOG_LEVEL=INFO
